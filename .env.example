# PostgreSQL connection string. Use the Supabase connection string in production.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Use a long, random value in each environment. Never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret

# Cloudinary media storage. Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional upload limits and allow-lists (bytes / comma-separated MIME types).
REPORT_MAX_MEDIA_FILE_SIZE=26214400
MAX_CONTENT_LENGTH=31457280
REPORT_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
REPORT_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime
