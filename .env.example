# PostgreSQL connection string. Use the Supabase connection string in production.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Use a long, random value in each environment. Never commit the real .env file.
DATABASE_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-separate-long-random-secret

# Production transport, session, token and abuse controls.
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=30
JWT_ACCESS_TOKEN_MINUTES=15
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PUBLIC_REPORT=5
RATE_LIMIT_WINDOW_SECONDS=900

# Cloudinary media storage. Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional upload limits and allow-lists (bytes / comma-separated MIME types).
REPORT_MAX_MEDIA_FILE_SIZE=26214400
MAX_CONTENT_LENGTH=31457280
MAX_FORM_MEMORY_SIZE=524288
REPORT_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
REPORT_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime
